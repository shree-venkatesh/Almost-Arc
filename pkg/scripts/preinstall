# Almost Arc for Zen .pkg: runs as root before anything is installed.
# Zen must be closed (the mod is installed into Zen's app and profile). If it's
# open, ask to quit it, and quit it the normal way (like Cmd+Q, so Zen saves
# your windows and tabs). Never force-quits.

running() { pgrep -x zen >/dev/null 2>&1; }
running || exit 0

U="$(stat -f%Su /dev/console)"
if [ -z "$U" ] || [ "$U" = root ] || [ "$U" = loginwindow ]; then
  echo "Zen is running and nobody is logged in to ask"; exit 1
fi
as_user() { launchctl asuser "$(id -u "$U")" sudo -u "$U" "$@"; }
# ask "message" "button": prints the button clicked ("" for Cancel)
ask() {
  as_user osascript -e "button returned of (display dialog \"$1\" with title \"Almost Arc for Zen\" buttons {\"Cancel\", \"$2\"} default button \"$2\" cancel button \"Cancel\" with icon caution)" 2>/dev/null
}
wait_quit() { for _ in $(seq 1 "$1"); do running || return 0; sleep 1; done; return 1; }

[ "$(ask "Zen needs to quit to install Almost Arc. Your windows and tabs are saved as usual." "Quit Zen")" = "Quit Zen" ] \
  || { echo "Cancelled: Zen is running"; exit 1; }
as_user osascript -e 'tell application "Zen" to quit' >/dev/null 2>&1
wait_quit 20 && exit 0

# Still open, e.g. Zen is asking "Close N tabs?". Let them finish quitting it.
for _ in 1 2 3; do
  [ "$(ask "Zen is still open. Quit it (Cmd+Q, and answer any question it shows), then click Continue." "Continue")" = "Continue" ] \
    || { echo "Cancelled: Zen is running"; exit 1; }
  wait_quit 5 && exit 0
done
echo "Zen is still running"
exit 1
